@phdthesis{phd_thesis,
  author    = {Lydia Kondylidou},
  title     = {Finding, Simplifying and Presenting Proofs Automatically},
  school    = {Ludwig-Maximilians-Universität München},
  year      = {2026},
  month     = {November},
  note      = {PhD thesis, magna cum laude},
  abstract  = {Automated theorem provers are computer programs that construct formal proofs of
mathematical theorems. Given a set of axioms and a formula to prove, they try to
determine whether the formula follows logically from the axioms. Producing a
proof in reasonable time, however, is only one of the challenges; the proof
should ideally also be concise, and it should be human-readable. This thesis
addresses all three challenges, contributing new techniques and tools for
finding, simplifying and presenting proofs automatically. We first address the
challenge of efficiently finding proofs for theorems. Specifically, we extend a
satisfiability modulo theories (SMT) solver with new quantifier reasoning
capabilities. SMT solvers form an empirically successful class of automated
theorem provers. They support first-order logic and, increasingly, higher-order
logic. To reason about quantifiers in these logics, SMT solvers rely on
quantifier instantiation, a class of techniques that map universally quantified
variables to heuristically chosen terms. We introduce MBQI-Enum, a quantifier
instantiation strategy that extends the existing model-based strategy with
syntax-guided synthesis techniques. Our strategy targets domains without well-
established quantifier instantiation techniques as well as higher-order formulas
whose universally quantified variables need to be mapped to λ-terms. Our
approach also supports Hilbert's choice operator ε, which is generally
considered to be difficult to reason about. By incorporating a syntax-guided
enumerator, the approach generates a broad set of candidate instantiations,
substantially increasing the success rate of the state-of-the-art SMT solver
cvc5 on both first- and higher-order formulas. We then address the challenge of
simplifying proofs generated by automated theorem provers. Indeed, the chains of
argumentation they produce can be very long and difficult to follow. In the
context of the Equational Theories Project, Fields medalist Terence Tao asked
the community to find alternatives to a complicated 62-step proof found by the
Vampire automated theorem prover. We introduce Krympa, a proof minimization tool
that combines brute force and heuristics, exploiting both Vampire and another
system called Twee. Krympa reduces the 62-step proof to 20 steps, each
corresponding to a single rewrite. In an empirical evaluation on 1431 equational
problems from the same project, our tool also performs well across the board,
reducing in particular a 151-step proof to only 10 steps. Finally, we address
the challenge that proofs generated by automated theorem provers are typically
difficult for humans to read and understand, partly because the proofs are
almost invariably by contradiction. Existing research on proof presentation
either targets first-order logic or focuses on purely equational reasoning. We
introduce a structured proof format for the Horn fragment of first-order logic
with built-in equality, which corresponds to Twee's logic. The format is
designed to express direct proofs, which are generally considered more readable
than proofs by contradiction. It combines equational rewriting chains and human-
style "have/hence" derivation steps. To interface with existing automated
theorem provers, we present a translation algorithm that converts proofs by
contradiction to our proof format.},
  pdf       = {PhD-Thesis-Kondylidou.pdf},
  selected  = {false}
}

@unpublished{masters_thesis,
title={Supporting a CDCL Sat Solver by BDD Methods - Masters Thesis},
author={Lydia Kondylidou},
abstract={Boolean satisfiability (SAT) is one of the most important problems of theoretical computer
  science with many practical applications in which Boolean Satisfiability (SAT) solvers are
  used in the background as high-performance reasoning engines. These applications include
  automated planning and scheduling, formal verification, and automated theorem proving. In
  the last decades, the performance of state-of-the-art SAT solvers has increased dramatically,
  thanks to the invention of advanced heuristics, preprocessing and inprocessing techniques,
  and data structures that allow efficient implementation of search space pruning. The in-
  creasing popularity of SAT in verification and synthesis encourages the search for additional
  speed-ups. This paper presents a new approach to support a Conflict Driven Clause Learning
  (CDCL) SAT solver with Binary Decision Diagram (BDD) techniques. While SAT and BDD
  techniques are often presented as mutually exclusive alternatives, this work points out that
  both can be improved by running in parallel and exchanging information. In this thesis, a
  BDD library is implemented in Rust, designed to support the latest version of the Glucose
  SAT solver. The proposed methods are based on efficient communication between the two
  architectures. Several benchmarks from the SAT competitions are run both on Glucose alone
  and Glucose with the contribution of the BDDs, and the results are compared. Eventually,
  the experiments show that the performance of Glucose is improved when running in parallel
  with the BDD solver.},
year={2023},
month={January},
pdf={Master-Thesis-Kondylidou.pdf}
}

@unpublished{bachelors_thesis,
title={Implementation and Comparison of Substitution Trees and Instance Tries - Bachelors Thesis},
author={Lydia Kondylidou},
supervisor={Francois Bry, Thomas Prokosch},
abstract={Term indexing methods have a major impact on the speed of logic programming lan-
  guages and automated theorem proving systems. Substitution trees are well estab-
  lished term indexes for logic programming and theorem proving because of their per-
  formances. However, they rely on heuristics and ignore the partial order that is in-
  herent to terms. On the other hand, instance tries have been recently proposed as a
  novel term index for logic programming and automated theorem proving. Instance
  tries make use of the term order without having to resort to heuristics. In this bache-
  lor's thesis, the efficiency of instance tries is examined in more detail on the basis of
  established benchmarks and and it is compared with that of substitution trees.},
year={2021},
month={March},
pdf={Bachelor-Thesis-Kondylidou.pdf},
html={https://www.en.pms.ifi.lmu.de/publications/diplomarbeiten/Lydia.Kondylidou/BA_Lydia.Kondylidou.pdf},
}